<Page x:Class="HotelManagement.WPF.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:HotelManagement.WPF.Views"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      mc:Ignorable="d"
      Title="DashboardPage">


    <Grid Background="#F5F7FA"
          Margin="25">


        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="70"/>

            <!-- Summary Cards -->
            <RowDefinition Height="Auto"/>

            <!-- Information panels -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- TITLE -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <fa:IconImage Icon="ChartLine"
                          Width="35"
                          Height="35"
                          Foreground="#2F5597"
                          Margin="0,0,10,0"/>
            
            <TextBlock Text="Hotel Dashboard"
                       FontSize="26"
                       Foreground="#2F5597"
                       FontWeight="SemiBold"/>

        </StackPanel>

        <!-- SUMMARY CARDS -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Guests Card -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="15">

                <StackPanel>

                    <fa:IconImage Icon="Users"
                                  Width="30"
                                  Height="30"
                                  Foreground="#4A6FA5"/>

                    <TextBlock Text="Total Guests"
                               Foreground="#4A6FA5"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtTotalGuests"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2F5597"/>

                </StackPanel>

            </Border>

            <!-- Rooms Card -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="15">

                <StackPanel>

                    <fa:IconImage Icon="Bed"
                                  Width="30"
                                  Height="30"
                                  Foreground="#4A6FA5"/>

                    <TextBlock Text="Available Rooms"
                               Foreground="#4A6FA5"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtAvailableRooms"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F5597"/>

                </StackPanel>

            </Border>

            <!-- Reservations Card -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="15">

                <StackPanel>

                    <fa:IconImage Icon="CalendarCheck"
                                  Width="30"
                                  Height="30"
                                  Foreground="#4A6FA5"/>

                    <TextBlock Text="Active Reservations"
                               Foreground="#4A6FA5"
                               Margin="0,10,0,0"/>


                    <TextBlock x:Name="txtActiveReservations"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F5597"/>

                </StackPanel>

            </Border>

            <!-- Invoice Card -->
            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="15">

                <StackPanel>

                    <fa:IconImage Icon="FileInvoiceDollar"
                                  Width="30"
                                  Height="30"
                                  Foreground="#4A6FA5"/>

                    <TextBlock Text="Pending Invoices"
                               Foreground="#4A6FA5"
                               Margin="0,10,0,0"/>

                    <TextBlock x:Name="txtUnpaidInvoices"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F5597"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- LOWER CONTENT -->
        <Grid Grid.Row="2"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Activity -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Recent Activity"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2F5597"/>

                    <Separator Margin="0,10"/>

                    <ListBox x:Name="lbActivities"
                             BorderThickness="0"
                             FontSize="12"/>

                </StackPanel>

            </Border>

            <!-- System Overview -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Margin="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="System Overview"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2F5597"/>

                    <Separator Margin="0,10"/>
                    <TextBlock Text="Date"
                                Foreground="#4A6FA5"/>

                    <TextBlock x:Name="txtCurrentDate"
                                   FontSize="16"
                                   Margin="0,5,0,15"/>

                    <TextBlock Text="Current Time"
                                    Foreground="#4A6FA5"/>

                    <TextBlock x:Name="txtCurrentTime"
                                FontSize="16"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>