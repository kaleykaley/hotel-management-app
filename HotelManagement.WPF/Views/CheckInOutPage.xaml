<Page x:Class="HotelManagement.WPF.Views.CheckInOutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelManagement.WPF.Views"
      xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CheckInOutPage">

    <Grid Background="#F5F7FA"
          Margin="25">
        <!--define rows-->
        <Grid.RowDefinitions>
            <!--title-->
            <RowDefinition Height="60"/>
            <!--dataGrid table-->
            <RowDefinition Height="Auto"/>
            <!--buttons-->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- TITLE - Row 0 -->
        <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <fa:IconImage Icon="DoorOpen"
                  Width="30"
                  Height="30"
                  Foreground="#2F5597"
                  Margin="0,0,10,0"/>

            <TextBlock
        Text="Front Desk"
        FontSize="24"
        Foreground="#2F5597"
        VerticalAlignment="Center"/>

        </StackPanel>

        <!--FILTERS - Row 1 -->
        <Border Grid.Row="1"
        Background="White"
        CornerRadius="12"
        Padding="20"
        HorizontalAlignment="Center"
        Margin="0,0,0,20">

            <!--2 rows: FILTERS / SEARCH/CLEAR BUTTONS-->
            <Grid>

                <!-- FILTERS + BUTTONS -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>

                </Grid.ColumnDefinitions>


                <!--Row 1: search/clear buttons-->
                <!-- BUTTONS -->
                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

                    <Button x:Name="btnCheckIn"
                        Content="Check In Guest"
                        Width="120"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="CheckIn_Click"/>

                    <Button x:Name="btnCheckOut"
                        Content="Check Out Guest"
                        Width="120"
                        Margin="20,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="CheckOut_Click"/>
                </StackPanel>

            </Grid>

        </Border>

        <!--Row 2: DataGrid to show all guests-->
        <DataGrid x:Name="dgReservations"
            Grid.Row="2"
            Margin="5,20,5,20"
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserResizeRows="False"
            CanUserSortColumns="False"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            AutoGenerateColumns="False"
            Background="White"
            BorderThickness="0"
            FontSize="14"
            RowHeight="40"
            HeadersVisibility="Column">

            <DataGrid.CellStyle>

                <Style TargetType="DataGridCell">

                    <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

                    <Setter Property="VerticalContentAlignment"
                Value="Center"/>

                </Style>

            </DataGrid.CellStyle>

            <!--DataGrid columns-->
            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Reservation ID"
                    Binding="{Binding ReservationId}"
                    Width="Auto"/>

                <DataGridTextColumn
                    Header="Guest Name"
                    Binding="{Binding GuestName}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Room #"
                    Binding="{Binding RoomNumber}"
                    Width="80"/>

                <DataGridTextColumn
                    Header="Check In"
                    Binding="{Binding CheckInDate}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Check Out"
                    Binding="{Binding CheckOutDate}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Status"
                    Binding="{Binding ReservationStatus}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Page>
