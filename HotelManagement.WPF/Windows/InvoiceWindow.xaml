<Window x:Class="HotelManagement.WPF.Windows.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.WPF.Windows"
        mc:Ignorable="d"
        Title="InvoiceWindow" Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F7FA"
          Margin="25">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="50"/>

            <!-- Form -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock x:Name="txtTitle"
                   Grid.Row="0"
                   Text="Generate Invoice"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#2F5597"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>


        <!-- FORM CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <Grid Margin="0,0,0,41">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                    <!--Total due / Issue date-->
                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>
                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <!-- RESERVATION COMBOBOX -->
                <TextBlock
                    Text="Reservation:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox
                    x:Name="cbReservations"
                    Grid.Column="1"
                    Margin="5"
                    Height="30"
                    MinWidth="220"
                    SelectionChanged="cbReservations_SelectionChanged"/>

                <Separator
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Margin="0,20"/>


                <!-- GUEST -->
                <TextBlock
                    Grid.Row="2"
                    Text="Guest:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="2"
                    IsReadOnly="True"
                    x:Name="txtGuestName"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>



                <!-- ROOM -->
                <TextBlock
                    Grid.Row="3"
                    Text="Room:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                  Grid.Row="3"
                  IsReadOnly="True"
                  x:Name="txtRoom"
                  Grid.Column="1"
                  Height="30"
                  Margin="5"/>

                <!-- ROOM CHARGE -->
                <TextBlock
                    Grid.Row="4"
                    Text="Room Charge:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="4"
                    IsReadOnly="True"
                    x:Name="txtRoomCharge"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>


                <!-- EXTRA SERVICES -->
                <TextBlock
                    Grid.Row="5"
                    Text="Extra Services:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    x:Name="txtExtraServices"
                    IsReadOnly="True"
                    Grid.Row="5"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>

                <Separator
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,30"/>


                <!-- TOTAL DUE -->
                <TextBlock
                    Grid.Row="7"
                    Text="Total Due:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    x:Name="txtTotalDue"
                    IsReadOnly="True"
                    Grid.Row="7"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>

                <!-- ISSUE DATE -->
                <TextBlock
                    Grid.Row="8"
                    Text="Issue Date:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <DatePicker
                    x:Name="dpIssueDate"
                    Grid.Row="8"
                    Grid.Column="1"
                    Margin="5"/>

            </Grid>

        </Border>



        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">


            <Button Content="Generate Invoice"
                    Width="120"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="GenerateInvoice_Click"/>


            <Button Content="Cancel"
                    Width="120"
                    Margin="100,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>


        </StackPanel>


    </Grid>

</Window>
