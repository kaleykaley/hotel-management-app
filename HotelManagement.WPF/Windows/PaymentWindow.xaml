<Window x:Class="HotelManagement.WPF.Windows.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.WPF.Windows"
        mc:Ignorable="d"
        Title="PaymentWindow" Height="650" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F7FA"
          Margin="25">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="50"/>

            <!-- Form -->
            <RowDefinition Height="Auto"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock x:Name="txtTitle"
                   Grid.Row="0"
                   Text="Register Payment"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#2F5597"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>


        <!-- FORM CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <Grid Margin="0,0,0,41">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                    <!--Total due / Issue date-->
                    
                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <!-- INVOICE SUMMARY -->
                <TextBlock
                    Text="Invoice ID:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    IsReadOnly="True"
                    x:Name="txtInvoiceId"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>
                
                <TextBlock
                    Grid.Row="1"
                    Text="Guest:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="1"
                    IsReadOnly="True"
                    x:Name="txtGuestName"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>

                <TextBlock
                    Grid.Row="2"
                    Text="Room #:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="2"
                    IsReadOnly="True"
                    x:Name="txtRoomNumber"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>
                
                <!-- SEPARATOR -->
                <Separator
                   Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Margin="0,10"/>

                <!-- TOTAL DUE -->
                <TextBlock
                    Grid.Row="4"
                    Text="TOTAL TO PAY:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="4"
                    x:Name="txtTotalDue"
                    IsReadOnly="True"
                    Grid.Column="1"
                    Height="30"
                    Margin="0"/>

                <TextBlock
                    Grid.Row="5"
                    Text="(Payment in full only)"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <!-- SEPARATOR -->
                <Separator
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,30"/>


                <!-- PAYMENT METHOD -->
                <TextBlock
                    Grid.Row="7"
                    Text="Payment Method:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox x:Name="cbPaymentMethod"
                          Grid.Row="7"
                          Grid.Column="1"
                          Height="30"
                          Margin="5"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem>
                        Cash
                    </ComboBoxItem>

                    <ComboBoxItem>
                        Credit_Card
                    </ComboBoxItem>

                    <ComboBoxItem>
                        Debit_Card
                    </ComboBoxItem>

                </ComboBox>

                <!-- PAYMENT DATE -->
                <TextBlock
                    Grid.Row="8"
                    Text="Payment Date:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <DatePicker
                    Grid.Row="8"
                    x:Name="dpPaymentDate"
                    Grid.Column="1"
                    Margin="5"/>

            </Grid>

        </Border>


        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">


            <Button Content="Register Payment"
                    Width="120"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="RegisterPayment_Click"/>


            <Button Content="Cancel"
                    Width="120"
                    Margin="20,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>


        </StackPanel>
        
    </Grid>

</Window>
