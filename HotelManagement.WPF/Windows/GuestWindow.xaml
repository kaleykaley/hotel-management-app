<Window x:Class="HotelManagement.WPF.Windows.GuestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.WPF.Windows"
        mc:Ignorable="d"
        Title="GuestWindow" Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F7FA"
          Margin="25">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="50"/>

            <!-- Form -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE -->
        <TextBlock x:Name="txtTitle"
                   Grid.Row="0"
                   Text="Guest"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#2F5597"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>


        <!-- FORM CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20">

            <Grid Margin="0,0,0,41">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>



                <!-- GUEST -->
                <TextBlock
                    Text="Guest Name:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    x:Name="txtGuestName"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>

                <!-- PHONE CONTACT -->
                <TextBlock
                    Grid.Row="1"
                    Text="Phone Contact:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    Grid.Row="1"
                    x:Name="txtPhoneContact"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>



                <!-- Email -->
                <TextBlock
                    Grid.Row="2"
                    Text="Email:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                  Grid.Row="2"
                  x:Name="txtEmail"
                  Grid.Column="1"
                  Height="30"
                  Margin="5"/>

                <!-- DOCUMENT TYPE -->
                <TextBlock
                    Grid.Row="3"
                    Text="Document Type:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <ComboBox x:Name="cbDocumentType"
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="30"
                    Margin="5">
                    
                    <ComboBoxItem>Passport</ComboBoxItem>
                    <ComboBoxItem>Driver's License</ComboBoxItem>
                    <ComboBoxItem>National ID</ComboBoxItem>
                    
                </ComboBox>



                <!-- DOCUMENT NUMBER -->
                <TextBlock
                    Grid.Row="4"
                    Text="Document Number:"
                    Foreground="#4A6FA5"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>

                <TextBox
                    x:Name="txtDocumentNumber"
                    Grid.Row="4"
                    Grid.Column="1"
                    Height="30"
                    Margin="5"/>

            </Grid>

        </Border>



        <!-- BUTTONS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">


            <Button Content="Save"
                    Width="120"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Save_Click"/>


            <Button Content="Cancel"
                    Width="120"
                    Margin="20,0,0,0"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Cancel_Click"/>


        </StackPanel>


    </Grid>

</Window>
