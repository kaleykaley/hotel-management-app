<Window x:Class="HotelManagement.WPF.Windows.StayHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="Stay History"
        Height="600"
        Width="900"
        Background="#F5F7FA">


    <Grid Margin="25">

        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="60"/>

            <!-- Summary -->
            <RowDefinition Height="Auto"/>

            <!-- Table -->
            <RowDefinition Height="*"/>

            <!-- Buttons -->
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- TITLE -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <fa:IconImage Icon="History"
                          Width="30"
                          Height="30"
                          Foreground="#2F5597"
                          Margin="0,0,10,0"/>


            <TextBlock Text="Guest Stay History"
                       FontSize="24"
                       Foreground="#2F5597"
                       VerticalAlignment="Center"/>

        </StackPanel>



        <!-- SUMMARY CARD -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="20"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">


            <Grid Width="500">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>



                <!-- Guest -->
                <TextBlock Text="Guest:"
                           FontWeight="SemiBold"
                           Foreground="#4A6FA5"
                           FontSize="14"
                           Margin="0,5"/>

                <TextBlock x:Name="txtGuestName"
                           Grid.Column="1"
                           FontSize="14"
                           Margin="10,5"/>



                <!-- Total stays -->
                <TextBlock Text="Total Stays:"
                           Grid.Row="1"
                           FontWeight="SemiBold"
                           Foreground="#4A6FA5"
                           FontSize="14"
                           Margin="0,5"/>


                <TextBlock x:Name="txtTotalStays"
                           Grid.Row="1"
                           Grid.Column="1"
                           FontSize="14"
                           Margin="10,5"/>



                <!-- Total nights -->
                <TextBlock Text="Total Nights:"
                           Grid.Row="2"
                           FontWeight="SemiBold"
                           Foreground="#4A6FA5"
                           FontSize="14"
                           Margin="0,5"/>


                <TextBlock x:Name="txtTotalNights"
                           Grid.Row="2"
                           Grid.Column="1"
                           FontSize="14"
                           Margin="10,5"/>


            </Grid>


        </Border>



        <!-- STAY HISTORY TABLE -->
        <DataGrid x:Name="dgStayHistory"
                  Grid.Row="2"
                  Margin="5,20,5,20"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AutoGenerateColumns="False"
                  Background="White"
                  BorderThickness="0"
                  FontSize="14"
                  RowHeight="40"
                  HeadersVisibility="Column">


            <DataGrid.CellStyle>

                <Style TargetType="DataGridCell">

                    <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                    <Setter Property="VerticalContentAlignment"
                            Value="Center"/>

                </Style>

            </DataGrid.CellStyle>

            <DataGrid.Columns>


                <DataGridTextColumn Header="Reservation ID"
                                    Binding="{Binding ReservationId}"
                                    Width="*"/>


                <DataGridTextColumn Header="Room #"
                                    Binding="{Binding RoomNumber}"
                                    Width="*"/>


                <DataGridTextColumn Header="Check In"
                                    Binding="{Binding CheckInDate}"
                                    Width="*"/>


                <DataGridTextColumn Header="Check Out"
                                    Binding="{Binding CheckOutDate}"
                                    Width="*"/>


                <DataGridTextColumn Header="Nights"
                                    Binding="{Binding Nights}"
                                    Width="*"/>

            </DataGrid.Columns>


        </DataGrid>

        <!-- CLOSE BUTTON -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Close"
                    Width="120"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>