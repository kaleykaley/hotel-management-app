
<Window x:Class="HotelManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">

    <!--button styling moved to App.xaml-->
    <Window.Resources>

    </Window.Resources>

    <!--creating 2 columns: Navigation Bar / Content-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!--left column: navigation bar-->
        <Border Background="#4A6FA5"
                Grid.Column="0">

            <Grid>
                <!--ROWS: Title / Buttons / Credits-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <TextBlock 
                    Grid.Row="0"
                    Text="HOTEL MANAGEMENT"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"/>

                <TextBlock 
                    Grid.Row="0"
                    Text="SYSTEM"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="0,45,0,20"/>


                <!-- BUTTONS -->
                <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Margin="0,0,0,0">

                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Dashboard"
                        Click="Dashboard_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Front Desk"
                        Click="FrontDesk_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Guests"
                        Click="Guests_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Rooms"
                        Click="Rooms_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Reservations"
                        Click="Reservations_Click"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                        Content="Billing"
                        Click="Invoices_Click"/>
                </StackPanel>


                <!-- CREDITS -->
                <StackPanel 
            Grid.Row="2"
            Margin="10"
            HorizontalAlignment="Center">

                    <Separator/>

                    <TextBlock Text="Version 1.0"
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Author Name"
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>
        
        <!--right column - dashboard content-->
        <Frame x:Name="MainFrame"
                Grid.Column="1"
                NavigationUIVisibility="Hidden"/>


    </Grid>
</Window>