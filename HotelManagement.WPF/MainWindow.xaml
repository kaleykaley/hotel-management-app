
<Window x:Class="HotelManagement.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HotelManagement.WPF"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1200">

    <!--button styling moved to App.xaml-->
    <Window.Resources>

    </Window.Resources>

    <!--creating 2 columns: Navigation Bar / Content-->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!--left column: navigation bar-->
        <Border Background="#4A6FA5"
                Grid.Column="0">

            <Grid>
                <!--ROWS: Title / Buttons / Credits-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TITLE -->
                <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <fa:IconImage Icon="Landmark"
                                  Width="35"
                                  Height="35"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,5"/>

                    <TextBlock Text="HOTEL MANAGEMENT"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        HorizontalAlignment="Center"/>

                    <TextBlock Text="SYSTEM"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    Margin="5,0,0,0">

                    <!-- DASHBOARD BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                        Click="Dashboard_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:IconImage Icon="Home"
                                          Width="20"
                                          Foreground="White"
                                          Margin="0,0,15,0"/>

                            <TextBlock Text="Dashboard"/>

                        </StackPanel>

                    </Button>
                    
                    <!-- FRONT DESK BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                            Click="FrontDesk_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:IconImage Icon="DoorOpen"
                                          Width="20"
                                          Foreground="White"
                                          Margin="0,0,15,0"/>

                            <TextBlock Text="Front Desk"/>

                        </StackPanel>

                    </Button>
                    <!-- GUESTS BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                        Click="Guests_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:IconImage Icon="Users"
                                          Width="20"
                                          Foreground="White"
                                          Margin="0,0,15,0"/>

                            <TextBlock Text="Guests"/>

                        </StackPanel>

                    </Button>

                    <!-- ROOMS BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                        Click="Rooms_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:IconImage Icon="Bed"
                                          Width="20"
                                          Foreground="White"
                                          Margin="0,0,15,0"/>

                            <TextBlock Text="Rooms"/>

                        </StackPanel>

                    </Button>

                    <!-- RESERVATIONS BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                        Click="Reservations_Click">

                        <StackPanel Orientation="Horizontal">

                            <fa:IconImage Icon="CalendarDays"
                                                Width="20"
                                                Foreground="White"
                                                Margin="0,0,15,0"/>

                            <TextBlock Text="Reservations"/>

                        </StackPanel>

                    </Button>
                    
                    <!-- BILLING BUTTON -->
                    <Button Style="{StaticResource NavButtonStyle}"
                        Click="Invoices_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="FileInvoiceDollar"
                                              Width="20"
                                              Foreground="White"
                                              Margin="0,0,15,0"/>

                            <TextBlock Text="Billing"/>
                        </StackPanel>
                    </Button>
                    
                </StackPanel>


                <!-- CREDITS -->
                <StackPanel 
            Grid.Row="2"
            Margin="10"
            HorizontalAlignment="Center">

                    <Separator/>

                    <TextBlock Text="Version 1.0"
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="Author Name"
                       Foreground="White"
                       FontSize="12"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>
        
        <!--right column - dashboard content-->
        <Frame x:Name="MainFrame"
                Grid.Column="1"
                NavigationUIVisibility="Hidden"/>


    </Grid>
</Window>